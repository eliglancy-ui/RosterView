# Database Configuration
# Leave DATABASE_URL unset to use the built-in database with sample data.
# Set it only to connect to a real PostgreSQL server:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/rosterview_dev

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Configuration
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# External APIs (for future integration)
INFINITE_CAMPUS_API_KEY=demo_key_placeholder
CANVAS_API_KEY=demo_key_placeholder
